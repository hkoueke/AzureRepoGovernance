<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GovernanceAuditor.Reporting : mise en forme des résultats.
    Aucune logique métier, aucun appel réseau : transforme un AuditRunResult en document.
  -->
  <PropertyGroup>
    <RootNamespace>GovernanceAuditor.Reporting</RootNamespace>
    <AssemblyName>GovernanceAuditor.Reporting</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GovernanceAuditor.Core\GovernanceAuditor.Core.csproj" />
  </ItemGroup>

  <!-- Les tests vérifient la neutralisation des textes non fiables (type interne). -->
  <ItemGroup>
    <InternalsVisibleTo Include="GovernanceAuditor.Tests" />
  </ItemGroup>

</Project>
