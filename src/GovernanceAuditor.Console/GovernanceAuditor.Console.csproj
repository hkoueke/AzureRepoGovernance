<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GovernanceAuditor.Console : point d'entrée, configuration, injection de
    dépendances et orchestration. AUCUNE logique métier (elle est dans Core).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GovernanceAuditor.Console</RootNamespace>
    <AssemblyName>GovernanceAuditor</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GovernanceAuditor.Core\GovernanceAuditor.Core.csproj" />
    <ProjectReference Include="..\GovernanceAuditor.Reporting\GovernanceAuditor.Reporting.csproj" />
    <ProjectReference Include="..\GovernanceAuditor.Infrastructure.AzureDevOps\GovernanceAuditor.Infrastructure.AzureDevOps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GovernanceAuditor.Tests" />
  </ItemGroup>

</Project>
