{
  "AzureDevOpsServer": {
    "BaseUrl": "https://tfs",
    "Collection": "Importation",
    "ApiVersion": "7.1",
    "AllowInsecureHttp": false
  },

  "Scope": {
    "Projects": [
      "Fwfc - Loc",
      "Fwfc-Spie"
    ]
  },

  "Rules": {
    "BranchInactiveDays": 90,
    "BranchAbandonedDays": 120,
    "ProtectedBranches": [ "main", "master", "develop" ],
    "RequiredReviewers": 2,
    "PipelineFailureThreshold": 3,
    "PullRequestStaleDays": 30
  },

  "Execution": {
    "MaxDegreeOfParallelism": 5,
    "HttpTimeoutSeconds": 30,
    "GlobalTimeoutMinutes": 10,
    "FailOnCritical": true,
    "MaxRepositoryFailureRatio": 0.10,
    "RecentRunsToInspect": 10
  },

  "Privacy": {
    "RedactActors": false
  },

  "Reporting": {
    "Format": "Markdown",
    "OutputDirectory": "./reports"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "GovernanceAuditor": "Information"
    }
  }
}
